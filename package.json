{
  "name": "webitup24",
  "version": "2.0.0",
  "private": true,
  "description": "WebItUp24 — immersive 3D agency portfolio. Next.js App Router + React Three Fiber + Sanity.",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,mdx,css,json}\"",
    "sanity:dev": "sanity dev",
    "sanity:deploy": "sanity deploy",
    "sanity:graphql": "sanity graphql deploy",
    "typegen": "sanity schema extract --path=./src/sanity/extract.json && sanity typegen generate",
    "gltf:optimize": "gltf-transform optimize public/models/raw.glb public/models/out.glb --compress draco --texture-compress ktx2"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@portabletext/react": "^3.2.1",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@react-three/drei": "^10.1.2",
    "@react-three/fiber": "^9.1.2",
    "@react-three/postprocessing": "^3.0.4",
    "@sanity/client": "^6.28.3",
    "@sanity/icons": "^3.7.0",
    "@sanity/image-url": "^1.1.0",
    "@sanity/vision": "^3.80.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.4.10",
    "gsap": "^3.13.0",
    "lenis": "^1.3.1",
    "next": "^15.4.0",
    "next-sanity": "^9.12.0",
    "postprocessing": "^6.37.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sanity": "^3.80.1",
    "sanity-plugin-media": "^2.3.2",
    "styled-components": "^6.1.15",
    "tailwind-merge": "^3.0.2",
    "three": "^0.178.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.178.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.22.0",
    "eslint-config-next": "^15.4.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.8.2"
  }
}
