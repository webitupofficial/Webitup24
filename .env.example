# ---------------------------------------------------------------------------
# Sanity — public (safe to expose, inlined into the client bundle)
# ---------------------------------------------------------------------------
# Found at https://sanity.io/manage → your project → API
NEXT_PUBLIC_SANITY_PROJECT_ID="your_project_id"
NEXT_PUBLIC_SANITY_DATASET="production"
# Pin this. Bumping it can change GROQ semantics — treat it as a dependency version.
NEXT_PUBLIC_SANITY_API_VERSION="2024-10-28"

# ---------------------------------------------------------------------------
# Sanity — private (server only; NEVER prefix with NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
# Viewer-scoped token. Used for: draft-mode preview, the Live Content API, and
# reading unpublished documents. Create at Manage → API → Tokens.
SANITY_API_READ_TOKEN="your_viewer_token"

# Shared secret for the on-demand revalidation webhook.
# Generate with:  openssl rand -base64 32
SANITY_REVALIDATE_SECRET="your_random_secret"

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Absolute origin, no trailing slash. Used for canonical URLs, OG images, sitemap.
NEXT_PUBLIC_SITE_URL="https://webitup24.com"

# ---------------------------------------------------------------------------
# Feature flags (optional — all default to off/auto when unset)
# ---------------------------------------------------------------------------
# Show the r3f stats HUD + shader uniform readout in the corner. Dev aid.
NEXT_PUBLIC_DEBUG_WEBGL="false"
# Force a specific device tier for QA: "high" | "mid" | "low". Unset = auto-detect.
NEXT_PUBLIC_FORCE_DEVICE_TIER=""
